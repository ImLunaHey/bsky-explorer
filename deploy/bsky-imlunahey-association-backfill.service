[Unit]
Description=Bluesky imlunahey relationship backfill
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=simple
User=luna
WorkingDirectory=/home/luna/code/imlunahey/bsky-explorer
ExecStart=/home/luna/code/imlunahey/bsky-explorer/target/release/backfill_associations --did did:plc:k6acu4chiwkixvdedcmdgmal --checkpoint /mnt/storage/bsky-observatory/backfill/imlunahey-associations.json
Restart=on-failure
RestartSec=30
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
