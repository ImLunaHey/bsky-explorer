STORAGE_ROOT=/mnt/storage/bsky-observatory
# Optional independent archive path; defaults to STORAGE_ROOT/archive.
# ARCHIVE_ROOT=/mnt/storage/bsky-observatory/archive
# Logical observatory allocation. Set STORAGE_BUDGET_BYTES for an exact override.
STORAGE_BUDGET_TIB=25
# STORAGE_BUDGET_BYTES=
JETSTREAM_URL=wss://jetstream2.us-east.bsky.network/subscribe
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
ARCHIVE_RETENTION_DAYS=30
ARCHIVE_SEGMENT_MIB=256
WINDOWS_SECONDS=60,300,3600,86400
COORDINATION_WINDOW_SECONDS=30
ANALYSIS_MAX_LAG_SECONDS=10
MIN_CLUSTER_ACCOUNTS=3
MIN_CLUSTER_EVENTS=3
STATE_RETENTION_HOURS=24
HOT_DETAIL_RETENTION_SECONDS=3600
HOT_DETAIL_MAX_EVENTS=250000
COMMUNITY_WINDOWS_SECONDS=3600,86400,604800
COMMUNITY_EVENT_TYPES=like,repost,follow,reply,quote
COMMUNITY_MIN_EDGE_WEIGHT=2
COMMUNITY_MAX_NODES=50000
COMMUNITY_MAX_EDGES=250000
COMMUNITY_MAX_INPUT_ROWS=2000000
COMMUNITY_INTERVAL_SECONDS=900
CLICKHOUSE_BATCH_SIZE=1000
CLICKHOUSE_FLUSH_SECONDS=2
IDENTITY_PROFILE_ENDPOINT=https://public.api.bsky.app/xrpc/app.bsky.actor.getProfile
IDENTITY_CACHE_CAPACITY=100000
IDENTITY_CACHE_TTL_SECONDS=21600
IDENTITY_NEGATIVE_TTL_SECONDS=300
IDENTITY_REQUESTS_PER_SECOND=10
